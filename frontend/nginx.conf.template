server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # Browser hardening for every response (the API adds its own as well).
    # HSTS: the public endpoint is HTTPS-only (TLS ends at the Container Apps
    # ingress). The CSP only restricts what is safe without auditing every
    # script/style source: no framing (clickjacking), no plugins, no <base>
    # hijack, forms post only here.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
    add_header Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'" always;

    # Request-body ceilings at the proxy, an outer backstop only. The API
    # enforces each company's own upload limits (companies.max_file_size_mb /
    # max_zip_size_mb, set by a platform admin) with specific messages, so these
    # must be at least as large as the LARGEST limit any company is given.
    # They are set by env vars (defaults in the Dockerfile).
    # UPLOAD_BODY_LIMIT covers single-document uploads (multipart: largest
    # per-file limit + ~1 MB). BULK_UPLOAD_BODY_LIMIT covers bulk zips.
    client_max_body_size ${UPLOAD_BODY_LIMIT};

    # Bulk zips: streamed straight through (no buffering at the proxy), so the
    # API can refuse an over-limit zip from its Content-Length at once.
    location /api/bulk-uploads {
        client_max_body_size ${BULK_UPLOAD_BODY_LIMIT};
        proxy_request_buffering off;
        proxy_pass ${API_UPSTREAM}/bulk-uploads;
        proxy_http_version 1.1;
        proxy_set_header Connection "";   # see /api/ below
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }


    # /api/* -> backend, with the /api prefix stripped (same as the Vite dev proxy).
    location /api/ {
        proxy_pass ${API_UPSTREAM}/;
        proxy_http_version 1.1;
        # Do not send "Connection: close" (nginx's default) upstream. The Container Apps
        # ingress in front of fddt-api truncates large responses to a request carrying it:
        # a ~350 KB case detail arrived cut at 65-230 KB, the browser showed
        # ERR_HTTP2_PROTOCOL_ERROR 200 and "Couldn't load this case". Same request without
        # the header: complete. An empty value removes the header (HTTP/1.1 keep-alive).
        proxy_set_header Connection "";
        # Route by the upstream app name: Container Apps ingress is host-based.
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        # JSON compresses ~10x (a 515 KB case detail goes out as ~36 KB).
        gzip on;
        gzip_proxied any;
        gzip_types application/json;
        gzip_min_length 1024;
        gzip_vary on;
    }

    # nginx's default mime.types has no .mjs entry; browsers refuse to run module scripts
    # (the pdf.js worker) served as application/octet-stream.
    location ~* \.mjs$ {
        default_type application/javascript;
    }

    # Single-page app: unknown paths fall back to index.html.
    location / {
        try_files $uri /index.html;
    }
}
