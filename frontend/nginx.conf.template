server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Uploads are capped at 10 MB by the API (MAX_UPLOAD_SIZE_BYTES); 11m leaves
    # room for multipart overhead so an oversized body is refused here (413)
    # before it reaches Uvicorn. Raise both together.
    client_max_body_size 11m;


    # /api/* -> backend, with the /api prefix stripped (same as the Vite dev proxy).
    location /api/ {
        proxy_pass ${API_UPSTREAM}/;
        proxy_http_version 1.1;
        # Route by the upstream app name: Container Apps ingress is host-based.
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # nginx's default mime.types has no .mjs entry; browsers refuse to run module scripts
    # (the pdf.js worker) served as application/octet-stream.
    location ~* \.mjs$ {
        default_type application/javascript;
    }

    # Single-page app: unknown paths fall back to index.html.
    location / {
        try_files $uri /index.html;
    }
}
